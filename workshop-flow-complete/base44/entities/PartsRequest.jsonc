{
  "name": "PartsRequest",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID of the Business this record belongs to"
    },
    "job_card_number": {
      "type": "string",
      "description": "Mandatory job card number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent_to_parts",
        "quoted",
        "awaiting_workshop_approval",
        "approved",
        "sent_to_advisor",
        "advisor_action_required",
        "sent_to_customer",
        "customer_approved",
        "customer_denied",
        "returned_to_workshop_controller",
        "recommendation_added"
      ],
      "default": "draft",
      "description": "Current workflow status"
    },
    "approval_action": {
      "type": "string",
      "enum": [
        "immediate",
        "recommendation"
      ],
      "description": "Type of approval action taken by Workshop Controller"
    },
    "approval_notes": {
      "type": "string",
      "description": "Notes added by Workshop Controller at time of approval"
    },
    "action_required_type": {
      "type": "string",
      "enum": [
        "add_to_recommendations"
      ],
      "description": "Specific type of action required from the assigned role"
    },
    "recommendation_text": {
      "type": "string",
      "description": "AI-generated or manually entered text to copy into customer invoice as a recommendation"
    },
    "parts": {
      "type": "array",
      "description": "Selected parts for the quote",
      "items": {
        "type": "object",
        "properties": {
          "part_type": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "tyre_size": {
            "type": "string"
          },
          "other_description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "labour_lines": {
      "type": "array",
      "description": "Per-repair-item labour time breakdown suggested by WC",
      "items": {
        "type": "object",
        "properties": {
          "part_type": {
            "type": "string"
          },
          "part_label": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "tyre_tread_depths": {
      "type": "object",
      "description": "Tyre tread depth measurements in mm",
      "properties": {
        "lh_front": {
          "type": "number"
        },
        "rh_front": {
          "type": "number"
        },
        "lh_rear": {
          "type": "number"
        },
        "rh_rear": {
          "type": "number"
        }
      }
    },
    "brake_pad_measurements": {
      "type": "object",
      "description": "Brake pad thickness measurements in mm",
      "properties": {
        "front_brakes": {
          "type": "number"
        },
        "rear_brakes": {
          "type": "number"
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional technician notes"
    },
    "parts_interpreter_notes": {
      "type": "string",
      "description": "Notes added by parts interpreter regarding the quote"
    },
    "quote_pdf_url": {
      "type": "string",
      "description": "PDF quote uploaded by Parts Interpreter"
    },
    "quote_pdf_text": {
      "type": "string",
      "description": "Text extracted from the uploaded quote PDF"
    },
    "quote_pdf_extracted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When quote PDF text was extracted"
    },
    "quote_total": {
      "type": "number",
      "description": "Total quote amount"
    },
    "technician_email": {
      "type": "string",
      "description": "Email of the technician who created the request"
    },
    "technician_name": {
      "type": "string",
      "description": "Name of the technician"
    },
    "parts_interpreter_email": {
      "type": "string",
      "description": "Email of the parts interpreter"
    },
    "workshop_controller_email": {
      "type": "string",
      "description": "Email of the workshop controller who approved"
    },
    "service_advisor_email": {
      "type": "string",
      "description": "Email of the service advisor"
    },
    "customer_approval_method": {
      "type": "string",
      "enum": [
        "phone",
        "email",
        "sms",
        "in_person",
        "other"
      ],
      "description": "DEPRECATED - Use customer_decision_method instead"
    },
    "customer_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "DEPRECATED - Use customer_decision_recorded_at instead"
    },
    "customer_decision": {
      "type": "string",
      "enum": [
        "approved",
        "denied"
      ],
      "description": "Final customer decision on the quote"
    },
    "customer_decision_method": {
      "type": "string",
      "enum": [
        "phone",
        "email",
        "sms",
        "in_person",
        "other"
      ],
      "description": "How customer decision was communicated"
    },
    "customer_decision_notes": {
      "type": "string",
      "description": "Optional notes about customer decision"
    },
    "customer_decision_recorded_by": {
      "type": "string",
      "description": "Email of user who recorded the decision"
    },
    "customer_decision_recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When customer decision was recorded"
    },
    "audit_log": {
      "type": "array",
      "description": "Status change history",
      "items": {
        "type": "object",
        "properties": {
          "previous_status": {
            "type": "string"
          },
          "new_status": {
            "type": "string"
          },
          "changed_by_email": {
            "type": "string"
          },
          "changed_by_name": {
            "type": "string"
          },
          "changed_at": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "customer_name": {
      "type": "string",
      "description": "Customer's full name"
    },
    "vehicle_type": {
      "type": "string",
      "description": "Vehicle type e.g. 2021 Hilux, Corolla, RAV4 Hybrid"
    },
    "parts_total_inc_gst": {
      "type": "number",
      "description": "Total amount including GST"
    },
    "parts_total_ex_gst": {
      "type": "number",
      "description": "Total amount excluding GST"
    },
    "advisor_sms_draft": {
      "type": "string",
      "description": "Generated SMS draft text"
    },
    "advisor_sms_variant": {
      "type": "string",
      "enum": [
        "short",
        "standard",
        "detailed"
      ],
      "default": "standard",
      "description": "SMS style variant"
    },
    "advisor_sms_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When SMS draft was last generated"
    },
    "advisor_sms_last_copied_at": {
      "type": "string",
      "format": "date-time",
      "description": "When SMS draft was last copied to clipboard"
    },
    "labour_time_selection": {
      "type": "string",
      "enum": [
        "0",
        "0.5",
        "1",
        "2",
        "3",
        "other"
      ],
      "description": "Labour time preset selection"
    },
    "labour_time_custom_hours": {
      "type": "number",
      "description": "Custom labour hours when other is selected"
    },
    "labour_rate_ex_gst": {
      "type": "number",
      "description": "Legacy field name — the value stored is the labour rate per hour inc GST in dollars"
    },
    "gst_percent": {
      "type": "number",
      "description": "GST percentage (default 10)"
    },
    "labour_time_selected_by": {
      "type": "string",
      "description": "Email of user who selected labour time"
    },
    "labour_time_selected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When labour time was selected"
    },
    "labour_change_log": {
      "type": "array",
      "description": "Labour time change history",
      "items": {
        "type": "object",
        "properties": {
          "old_selection": {
            "type": "string"
          },
          "new_selection": {
            "type": "string"
          },
          "old_hours": {
            "type": "number"
          },
          "new_hours": {
            "type": "number"
          },
          "changed_by_email": {
            "type": "string"
          },
          "changed_by_name": {
            "type": "string"
          },
          "changed_at": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "parts_eta_selection": {
      "type": "string",
      "enum": [
        "stock",
        "ex_vh",
        "ex_melb",
        "ex_syd",
        "other"
      ],
      "description": "Parts availability ETA"
    },
    "parts_eta_custom_text": {
      "type": "string",
      "description": "Custom ETA details when Other is selected"
    },
    "parts_eta_set_by": {
      "type": "string",
      "description": "Email of user who set parts ETA"
    },
    "parts_eta_set_at": {
      "type": "string",
      "format": "date-time",
      "description": "When parts ETA was set"
    },
    "parts_eta_change_log": {
      "type": "array",
      "description": "Parts ETA change history",
      "items": {
        "type": "object",
        "properties": {
          "old_selection": {
            "type": "string"
          },
          "new_selection": {
            "type": "string"
          },
          "old_custom_text": {
            "type": "string"
          },
          "new_custom_text": {
            "type": "string"
          },
          "changed_by_email": {
            "type": "string"
          },
          "changed_by_name": {
            "type": "string"
          },
          "changed_at": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether the request has been archived"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the request was archived"
    },
    "archived_by": {
      "type": "string",
      "description": "Email of user who archived the request"
    },
    "delete_requested": {
      "type": "boolean",
      "default": false,
      "description": "Whether deletion has been requested"
    },
    "delete_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When deletion was requested"
    },
    "delete_requested_by": {
      "type": "string",
      "description": "Email of user who requested deletion"
    },
    "wc_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether Workshop Controller has marked this as completed"
    },
    "wc_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Workshop Controller marked as completed"
    },
    "wc_completed_by": {
      "type": "string",
      "description": "Email of Workshop Controller who marked as completed"
    },
    "wc_completion_note": {
      "type": "string",
      "description": "Optional note from Workshop Controller on completion"
    },
    "action_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether this request requires action from assigned role"
    },
    "action_required_since": {
      "type": "string",
      "format": "date-time",
      "description": "When action was first required"
    },
    "action_required_role": {
      "type": "string",
      "enum": [
        "technician",
        "parts_interpreter",
        "workshop_controller",
        "service_advisor",
        "service_manager"
      ],
      "description": "Which role needs to take action"
    },
    "action_cleared_at": {
      "type": "string",
      "format": "date-time",
      "description": "When action requirement was cleared"
    },
    "action_cleared_by": {
      "type": "string",
      "description": "Email of user who cleared action requirement"
    },
    "follow_up_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether a follow-up SMS has been confirmed as sent"
    },
    "follow_up_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When follow-up was marked as completed"
    },
    "follow_up_completed_by": {
      "type": "string",
      "description": "Email of user who confirmed the follow-up"
    },
    "follow_up_completed_by_name": {
      "type": "string",
      "description": "Name of user who confirmed the follow-up"
    },
    "follow_up_notes": {
      "type": "string",
      "description": "Optional notes recorded at time of follow-up confirmation"
    }
  },
  "required": [
    "job_card_number",
    "parts"
  ]
}
