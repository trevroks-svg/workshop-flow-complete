{
  "name": "Notification",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID of the Business this notification belongs to"
    },
    "recipient_email": {
      "type": "string",
      "description": "User who should receive this notification"
    },
    "recipient_role": {
      "type": "string",
      "enum": [
        "technician",
        "parts_interpreter",
        "workshop_controller",
        "service_advisor",
        "admin"
      ],
      "description": "Target role for notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_request",
        "quote_returned",
        "approval_required",
        "approval_completed",
        "sent_to_customer",
        "customer_approved",
        "customer_denied",
        "overdue",
        "status_update"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "description": {
      "type": "string",
      "description": "Optional extended description or context for the notification",
      "maxLength": 1000
    },
    "request_id": {
      "type": "string",
      "description": "Related parts request ID"
    },
    "job_card_number": {
      "type": "string",
      "description": "Related job card number"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    }
  },
  "required": [
    "type",
    "title",
    "message"
  ]
}