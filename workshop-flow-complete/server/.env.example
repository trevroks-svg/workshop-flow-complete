# Copy to server/.env and fill in the values. Never commit the filled-in file.
# See SETUP.md for where each value comes from.

# Supabase (Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Resend (notification emails) — free at resend.com
RESEND_API_KEY=re_your_resend_key_here
FROM_EMAIL=Workshop Flow <noreply@yourdomain.com>

# OpenAI (AI repair analysis, SMS drafts, recommendation text, labour analysis)
OPENAI_API_KEY=sk-your-openai-key-here
# Model overrides (optional — all default to gpt-5.4-nano)
# OPENAI_ANALYSE_REPAIRS_MODEL=gpt-5.4-nano
# OPENAI_FOLLOW_UP_SMS_MODEL=gpt-5.4-nano
# OPENAI_ADVISOR_SMS_MODEL=gpt-5.4-nano
# OPENAI_RECOMMENDATION_MODEL=gpt-5.4-nano
# OPENAI_LABOUR_MODEL=gpt-5.4-nano

# Cron secret for POST /api/check-overdue-requests (optional)
# CRON_SECRET=choose-a-long-random-string

# Frontend origin allowed by CORS (production frontend URL)
CLIENT_URL=http://localhost:5173

# Server port (optional, defaults to 3001)
# PORT=3001
