{
  "name": "VehicleInspection",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID of the Business this record belongs to"
    },
    "request_id": {
      "type": "string",
      "description": "ID of the related PartsRequest job"
    },
    "job_card_number": {
      "type": "string",
      "description": "Job card number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "reviewed"
      ],
      "default": "draft",
      "description": "Inspection status"
    },
    "description": {
      "type": "string",
      "description": "Optional extended description or notes about this inspection",
      "maxLength": 1000
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "vehicle_registration": {
      "type": "string",
      "description": "Vehicle registration plate"
    },
    "vehicle_make_model": {
      "type": "string",
      "description": "Vehicle make and model"
    },
    "odometer": {
      "type": "string",
      "description": "Odometer reading"
    },
    "technician_name": {
      "type": "string",
      "description": "Technician name"
    },
    "technician_email": {
      "type": "string",
      "description": "Technician email"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When inspection was submitted"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When inspection was reviewed"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of reviewer"
    },
    "brake_measurements": {
      "type": "object",
      "description": "Brake pad measurements",
      "properties": {
        "front_left": {
          "type": "string"
        },
        "front_right": {
          "type": "string"
        },
        "rear_left": {
          "type": "string"
        },
        "rear_right": {
          "type": "string"
        },
        "front_disc_condition": {
          "type": "string"
        },
        "rear_disc_condition": {
          "type": "string"
        }
      }
    },
    "tyre_measurements": {
      "type": "object",
      "description": "Tyre tread depth measurements",
      "properties": {
        "front_left": {
          "type": "string"
        },
        "front_right": {
          "type": "string"
        },
        "rear_left": {
          "type": "string"
        },
        "rear_right": {
          "type": "string"
        },
        "spare": {
          "type": "string"
        },
        "wear_pattern": {
          "type": "string"
        }
      }
    },
    "multipoint_inspection": {
      "type": "object",
      "description": "Multipoint inspection results. Each key is an item id with {status: 'green'|'amber'|'red', notes: string}",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "technician_notes": {
      "type": "string",
      "description": "General technician notes"
    },
    "diagnostic_concern": {
      "type": "string",
      "description": "Diagnostic concern"
    },
    "diagnostic_cause": {
      "type": "string",
      "description": "Diagnostic cause"
    },
    "diagnostic_correction": {
      "type": "string",
      "description": "Diagnostic correction"
    },
    "photo_urls": {
      "type": "array",
      "description": "Uploaded inspection photo URLs",
      "items": {
        "type": "string"
      }
    },
    "service_advisor_email": {
      "type": "string",
      "description": "Email of the service advisor to notify"
    }
  },
  "required": [
    "job_card_number"
  ]
}