{
  "name": "QuoteRequestPhoto",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "ID of the Business this photo belongs to"
    },
    "quote_request_id": {
      "type": "string",
      "description": "ID of the related quote request"
    },
    "photo_url": {
      "type": "string",
      "description": "URL of the uploaded photo"
    },
    "caption": {
      "type": "string",
      "description": "Optional photo caption"
    },
    "description": {
      "type": "string",
      "description": "Optional extended description of the photo content or context",
      "maxLength": 1000
    },
    "taken_by_email": {
      "type": "string",
      "description": "Email of user who uploaded the photo"
    },
    "taken_by_name": {
      "type": "string",
      "description": "Name of user who uploaded the photo"
    },
    "taken_by_role": {
      "type": "string",
      "description": "Role of user who uploaded the photo"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "internal",
        "advisor_approved"
      ],
      "default": "internal",
      "description": "Photo visibility level"
    }
  },
  "required": [
    "quote_request_id",
    "photo_url"
  ]
}