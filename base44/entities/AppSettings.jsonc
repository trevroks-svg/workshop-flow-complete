{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "description": "Unique setting identifier"
    },
    "setting_value": {
      "type": "number",
      "description": "Numeric value for the setting"
    },
    "setting_description": {
      "type": "string",
      "description": "Description of the setting"
    },
    "description": {
      "type": "string",
      "description": "Optional extended description for this setting",
      "maxLength": 1000
    },
    "last_updated_by": {
      "type": "string",
      "description": "Email of user who last updated"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When setting was last updated"
    }
  },
  "required": [
    "setting_key",
    "setting_value"
  ]
}